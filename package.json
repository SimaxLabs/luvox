{
  "name": "motio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 127.0.0.1\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
