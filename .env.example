# Create an API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional persistent data directory for model config and saved prompts. Defaults to .luvox in the working directory.
# LUVOX_DATA_DIR=/absolute/path/to/luvox-data

# Optional local MFLUX image generation (macOS on Apple Silicon only).
# mflux-generate-flux2-edit must be beside MFLUX_FLUX2_BINARY or on PATH.
# MFLUX_FLUX2_BINARY=/absolute/path/to/mflux-generate-flux2
# MFLUX_TIMEOUT_MINUTES=30
# Separate cumulative budget for model resource checks/downloads; both limits allow 1–240 minutes.
# MFLUX_DOWNLOAD_TIMEOUT_MINUTES=120
# Keep one model loaded between images; 0 disables reuse. Low RAM always unloads.
# MFLUX_KEEP_ALIVE_MINUTES=5

# Optional local h3.c generation (macOS on Apple Silicon only).
# H3_BINARY=/absolute/path/to/h3.c/h3
# H3_MODEL_DIR=/absolute/path/to/MiniMax-H3
# H3_RUNTIME_DIR=/absolute/path/to/h3.c
# H3_JOBS_DIR=/absolute/path/to/local/jobs
# H3_TIMEOUT_MINUTES=120
